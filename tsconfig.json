{
  // Typechecks the source and the tests; the published build uses tsconfig.build.json
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    // Node runs the tests with its own type stripping, which needs .ts imports
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": []
}
